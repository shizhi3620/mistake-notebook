page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 8px;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: #8a8f99;
  font-size: 26rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
}

.btn-plain {
  background: #eef0f3;
  color: #1f2329;
}

.btn-danger {
  background: #ffffff;
  color: #d83931;
  border: 1rpx solid #f0c0bd;
}

.btn[disabled] {
  opacity: 0.5;
}

.field {
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #5a5f66;
  margin-bottom: 8rpx;
}

.input {
  background: #ffffff;
  border: 1rpx solid #dfe2e6;
  border-radius: 8px;
  padding: 16rpx 20rpx;
  min-height: 88rpx;
  line-height: 56rpx;
  width: 100%;
  box-sizing: border-box;
}

input.input {
  height: 88rpx;
}

textarea.input {
  min-height: 120rpx;
  line-height: 48rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  background: #eef0f3;
  color: #5a5f66;
  border-radius: 6px;
  padding: 4rpx 14rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.tag-green {
  background: #e6f7ee;
  color: #07a35a;
}

.tag-orange {
  background: #fdf1e3;
  color: #c07a1a;
}

.warning {
  background: #fdf1e3;
  color: #9a5f0b;
  border-radius: 8px;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}
